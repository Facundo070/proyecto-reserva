datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DOCENTE
}

// ------------------------------------------------------
// PERSONAS Y USUARIOS
// ------------------------------------------------------

model Person {
  id        Int       @id @default(autoincrement())
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  dni       String    @unique
  email     String    @unique
  profiles  Profile[]

  @@map("persons")
}

model User {
  id                  Int           @id @default(autoincrement())
  name                String
  emailVerified       DateTime?     @map("email_verified")
  password            String
  role                Role          @default(DOCENTE)
  deletedAt           DateTime?     @map("deleted_at")
  profiles            Profile[]
  createdReservations Reservation[]

  @@map("users")
}

model Profile {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  personId     Int           @map("person_id")
  user         User          @relation(fields: [userId], references: [id])
  person       Person        @relation(fields: [personId], references: [id])
  reservations Reservation[]

  @@map("profiles")
}

// ------------------------------------------------------
// RECURSOS E INVENTARIO
// ------------------------------------------------------

model StatusResource {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  resources Resource[]

  @@map("status_resources")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  resources Resource[]

  @@map("categories")
}

model Resource {
  id           Int                   @id @default(autoincrement())
  name         String
  marca        String?
  description  String?
  statusId     Int                   @map("status_id")
  categoryId   Int                   @map("category_id")
  status       StatusResource        @relation(fields: [statusId], references: [id])
  category     Category              @relation(fields: [categoryId], references: [id])
  reservations ReservationResource[]

  @@map("resources")
}

// ------------------------------------------------------
// RESERVAS
// ------------------------------------------------------

model StatusReservation {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  reservations Reservation[]

  @@map("status_reservations")
}

model Reservation {
  id                  Int                   @id @default(autoincrement())
  createdByUserId     Int                   @map("created_by_user")
  startDate           DateTime              @map("start_date")
  endDate             DateTime              @map("end_date")
  statusReservationId Int                   @map("status_reservation_id")
  profileId           Int                   @map("profile_id")
  createdBy           User                  @relation(fields: [createdByUserId], references: [id])
  status              StatusReservation     @relation(fields: [statusReservationId], references: [id])
  profile             Profile               @relation(fields: [profileId], references: [id])
  resources           ReservationResource[]

  @@index([startDate, endDate])
  @@map("reservations")
}

model ReservationResource {
  id            Int         @id @default(autoincrement())
  reservationId Int         @map("reservation_id")
  resourceId    Int         @map("resource_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  resource      Resource    @relation(fields: [resourceId], references: [id])

  @@unique([reservationId, resourceId])
  @@map("reservation_resources")
}